# ============================================================================
# EDTTI UMS — Environment template (copy to .env and fill in)
# V2 uses PostgreSQL (Neon) via Drizzle. V1's MongoDB is no longer used.
# ============================================================================

# ---------- Database (V2 — Postgres / Neon) ----------
# Get a free Neon database at https://neon.tech and paste the connection string here.
# Must end with ?sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Connection pool sizing (per Node worker). When pm2 runs in cluster mode,
# keep  PM2_INSTANCES * DB_POOL_MAX + headroom  <  Postgres max_connections.
# Defaults are fine for Neon's pooled endpoint; lower DB_POOL_MAX when
# self-hosting Postgres with a small max_connections.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=20
DB_CONNECT_TIMEOUT=15

# ---------- JWT / Sessions ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Server refuses to start without it.
JWT_SECRET=replace_this_with_at_least_32_random_characters
JWT_EXPIRES_IN=2h
SESSION_SECRET=replace_this_with_at_least_32_random_characters

# Set to "true" ONLY when the server is reachable via HTTPS. When true, the
# auth cookie will carry the Secure flag and browsers will reject it on
# plain HTTP origins. Leave unset or "false" on HTTP staging.
COOKIE_SECURE=false

# ---------- CORS ----------
# Comma-separated allowed origins for production. Empty in dev allows localhost.
ALLOWED_ORIGINS=

# ---------- Initial seed credentials (used by drizzle/seed.js only) ----------
# Must be: uppercase + lowercase + number + special char, min 12 chars.
INITIAL_ADMIN_PASSWORD=

# ---------- Email (Brevo HTTP API) ----------
# Brevo replaced Gmail SMTP (DigitalOcean blocks outbound port 465/587).
# Get your key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.tld
BREVO_SENDER_NAME=EDTTI University Management System

# ---------- Server ----------
PORT=5502
NODE_ENV=development

# Number of pm2 cluster workers (see ecosystem.config.js). "max" = one per CPU.
PM2_INSTANCES=2

# ---------- AWS S3 (file uploads — optional in dev) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
