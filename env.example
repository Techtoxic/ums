# ============================================================================
# EDTTI UMS — Environment template (copy to .env and fill in)
# V2 uses PostgreSQL (Neon) via Drizzle. V1's MongoDB is no longer used.
# ============================================================================

# ---------- Database (V2 — Postgres / Neon) ----------
# Get a free Neon database at https://neon.tech and paste the connection string here.
# Must end with ?sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ---------- JWT / Sessions ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. Server refuses to start without it.
JWT_SECRET=replace_this_with_at_least_32_random_characters
JWT_EXPIRES_IN=2h
SESSION_SECRET=replace_this_with_at_least_32_random_characters

# ---------- CORS ----------
# Comma-separated allowed origins for production. Empty in dev allows localhost.
ALLOWED_ORIGINS=

# ---------- Initial seed credentials (used by drizzle/seed.js only) ----------
# Must be: uppercase + lowercase + number + special char, min 12 chars.
INITIAL_ADMIN_PASSWORD=

# ---------- Email (Brevo HTTP API) ----------
# Brevo replaced Gmail SMTP (DigitalOcean blocks outbound port 465/587).
# Get your key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.tld
BREVO_SENDER_NAME=EDTTI University Management System

# ---------- Server ----------
PORT=5502
NODE_ENV=development

# ---------- AWS S3 (file uploads — optional in dev) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
