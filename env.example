# Database Configuration
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/university_management

# For MongoDB Atlas Cloud (recommended):
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.7t0qanl.mongodb.net/university_management?retryWrites=true&w=majority&appName=Cluster0

# JWT Secret (REQUIRED in production)
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters. The server will refuse to start in production without it.
JWT_SECRET=replace_this_with_at_least_32_random_characters
# SEV-H-013: short-lived access tokens (refresh tokens are a Stage 3 item)
JWT_EXPIRES_IN=2h

# Session Secret (used for any future session storage)
# Generate the same way as JWT_SECRET above.
SESSION_SECRET=replace_this_with_at_least_32_random_characters

# Allowed Origins for CORS (comma-separated). Use your production domain(s).
# Leave empty in development to allow localhost.
ALLOWED_ORIGINS=https://your-production-domain.example.com

# Default admin password (used ONLY when seeding initial accounts on a fresh DB).
# After seeding, immediately log in, change email and password, then rotate this value.
# Must meet complexity: uppercase + lowercase + number + special char, min 12 chars.
INITIAL_ADMIN_PASSWORD=

# Email Configuration (Gmail)
# IMPORTANT: Use Gmail App Password, not regular password
# 1. Enable 2-Factor Authentication on Gmail
# 2. Go to Google Account > Security > 2-Step Verification > App passwords
# 3. Generate app password and use the 16-character code below
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_app_password

# Server Configuration
PORT=5502
NODE_ENV=development

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1
