# Environment Variables
.env
.env.local
.env.production

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploads
uploads/
!uploads/.gitkeep

# Logs
logs/
*.log

# OS Files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# AI coding assistants (per-developer local config; do not commit)
.claude/
.cursor/

# Build outputs
dist/
build/
.cache/

# Database dumps (but keep Drizzle migration files)
*.sql
*.dump
!drizzle/migrations/**/*.sql

# PM2
.pm2/

# Temporary files
tmp/
temp/

# Scratch diffs / audit artifacts (must never be committed - see SEV-C-003)
temp_diff.txt
*.diff

# SEV-H-015: one-time seeded admin credentials file (read once, then delete)
.seed-credentials.txt

# Markdown reports and other docs — keep README.md tracked, ignore everything else
*.md
!README.md
